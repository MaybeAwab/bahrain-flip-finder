# Public listing sources (comma-separated)
# FLIP_SOURCE_URLS=https://bh.opensooq.com/en/electronics,https://www.dubizzle.com.bh/en/electronics-home-appliances/

# Local pricing assumptions
TRANSPORT_BHD=2
REPAIR_RESERVE_BHD=3
SELLING_FEE_BHD=0
SALE_REALIZATION_RATE=0.85
TARGET_PROFIT_BHD=15
MINIMUM_ROI_PERCENT=25
MINIMUM_CONFIDENCE=0.60
MINIMUM_COMPARABLES=3

# Collection
HTTP_TIMEOUT_SECONDS=15
HTTP_MIN_GAP_SECONDS=1.5
MAX_RESULTS_PER_SOURCE=100
COLLECT_WORKERS=3
POLL_SECONDS=1800
FLIP_DB_PATH=data/flip_finder.sqlite3

# AI provider order and bounded retry behavior
AI_PROVIDER_ORDER=cloud5,deepseek
AI_MAX_RETRIES=2
AI_RETRY_BASE_SECONDS=2
AI_KEY_COOLDOWN_SECONDS=120
AI_TIMEOUT_SECONDS=120

# Cloud5 / TaBiToken
CLOUD5_API_KEY_1=
CLOUD5_API_KEY_2=
CLOUD5_API_KEY_3=
CLOUD5_BASE_URL=https://tabitoken.com/v1
CLOUD5_MODEL=glm-5.3-flash

# DeepSeek
DEEPSEEK_API_KEY_1=
DEEPSEEK_API_KEY_2=
DEEPSEEK_BASE_URL=https://api.deepseek.com
